# Server-only variables (never prefix with NEXT_PUBLIC_).
# The app works with a local or a hosted Supabase project; only these values change.

# --- Local (pnpm db:start, then `supabase status` to see the values) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

# --- Hosted (Supabase dashboard > Project Settings > API Keys) ---
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...

# Legacy alternative to SUPABASE_SECRET_KEY: the service_role JWT
# SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for POST /api/v1/products/import (sent by the local n8n workflow).
# Generate one with: openssl rand -base64 32
PRODUCTS_IMPORT_TOKEN=
# Where n8n sends the products (read by docker-compose.n8n.yml). Default: the app on
# this machine. For the deployed app use https://<project>.vercel.app and set the
# same PRODUCTS_IMPORT_TOKEN in Vercel.
# APP_URL=http://host.docker.internal:3000

# AI summary on the product reviews page (specs/product-reviews.md), via Mastra.
# Optional: without a key the page works and the summary says "Summary unavailable right now".
OPENAI_API_KEY=
# Model used for the summary, as "provider/model" (default below)
# FEEDBACK_SUMMARY_MODEL=openai/gpt-4.1-nano
# Hours the summary model stays off after an OpenAI quota, billing or invalid-key
# error (circuit breaker stored in the app_flags table; cached summaries still show)
# AI_DISABLED_HOURS=6
