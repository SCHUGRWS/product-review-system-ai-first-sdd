{
  "name": "product-review-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:test": "supabase test db --local",
    "n8n:build": "node n8n/build-workflow.mjs",
    "n8n:up": "docker compose -f docker-compose.n8n.yml --env-file .env.local up -d",
    "n8n:down": "docker compose -f docker-compose.n8n.yml down",
    "n8n:import": "docker compose -f docker-compose.n8n.yml exec n8n n8n import:workflow --input=/workflows/amazon-deals-import.json && docker compose -f docker-compose.n8n.yml restart n8n",
    "n8n:schedule:on": "docker compose -f docker-compose.n8n.yml exec n8n n8n publish:workflow --id=AmzDealsImport01 && docker compose -f docker-compose.n8n.yml restart n8n",
    "n8n:schedule:off": "docker compose -f docker-compose.n8n.yml exec n8n n8n unpublish:workflow --id=AmzDealsImport01 && docker compose -f docker-compose.n8n.yml restart n8n"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@mastra/core": "1.73.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.3",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.57.0",
    "nanoid": "^6.0.2",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.11.2"
}
